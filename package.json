{
  "name": "rloop",
  "version": "0.0.1",
  "description": "Evidence-based merge gate for AI-authored PRs. Exit codes lie; prove green with output.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "rloop": "./dist/cli.js",
    "rloop-mcp": "./dist/mcp/server.js"
  },
  "files": [
    "dist",
    "examples",
    "prompts",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "picomatch": "^4.0.2",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/picomatch": "^3.0.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
